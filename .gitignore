# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Cargo
# We don't ignore Cargo.lock on purpose. We use the nightly version of the Rust compiler,
# which tends to be unstable. Thus to have a reproducible kernel, we also commit the 
# Cargo.lock file.
Cargo.html
Cargo.pdf
Cargo.toml.orig

# OS
.DS_Store
.env
.idea/
.vscode/
/target
.antigravitycli/

# Host triple duplicate specifications
triad-llvm-target.json
